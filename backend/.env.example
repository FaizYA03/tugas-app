PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tugas_db

# Rahasia penandatangan JWT (WAJIB diganti di produksi, minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
# Masa berlaku token: mis. 15m, 12h, 7d
JWT_EXPIRES_IN=7d

# Daftar origin frontend yang diizinkan (pisahkan koma bila lebih dari satu)
FRONTEND_URL=http://localhost:5173

# Batas request per IP per 15 menit (global & khusus auth)
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
